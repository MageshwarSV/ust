        <label for="billingMonth">Select Billing Month:</label>
        <input type="month" id="billingMonth" />
    </div>
  </div>

  <div class="buttons-container" id="buttonsContainer">
    <p class="loading-msg">Loading companies...</p>
  </div>

  <div class="status-box" id="statusBox"></div>

  <script>
    const BASE = '';

    // Auto-set the dropdown to last month by default
    document.addEventListener("DOMContentLoaded", () => {
        const d = new Date();
        d.setMonth(d.getMonth() - 1);
        const yyyy = d.getFullYear();
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        document.getElementById('billingMonth').value = `${yyyy}-${mm}`;
    });

    async function loadProfiles() {
      try {
        const res = await fetch(BASE + '/awscost/api/profiles');
        const profiles = await res.json();
        const container = document.getElementById('buttonsContainer');
        container.innerHTML = '';
        if (!profiles || profiles.length === 0) {
          container.innerHTML = '<p class="loading-msg">No companies found in credentials file.</p>';
          return;
        }
        profiles.forEach(p => {
          const card = document.createElement('div');
          card.className = 'company-card';
          card.id = 'card-' + p.companyName;
          card.innerHTML = `
            <div class="company-name">${p.companyName}</div>
            <div class="env-tags">
              ${p.environments.map(e => `<span class="env-tag">${e}</span>`).join('')}
            </div>`;
          card.addEventListener('click', () => generateReport(p, card));
          container.appendChild(card);
        });
      } catch (e) {
        document.getElementById('buttonsContainer').innerHTML =
          '<p class="loading-msg" style="color:#f87171">Failed to load profiles. Is the server running?</p>';
      }
    }

    async function generateReport(profile, card) {
      const statusBox = document.getElementById('statusBox');
      const selectedMonth = document.getElementById('billingMonth').value; // e.g. "2026-04"
      
      card.classList.add('loading');
      card.innerHTML += '<div class="spinner"></div>';
      statusBox.className = 'status-box';
      statusBox.innerHTML = '';

      // Create payload to send to Java backend
      const payload = {
        companyName: profile.companyName,
        environments: profile.environments,
        profiles: profile.profiles,
        yearMonth: selectedMonth // <--- THIS FIXES THE BUG!
      };

      try {
        const res = await fetch(BASE + '/awscost/api/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (res.ok && data.status === 'success') {
          statusBox.className = 'status-box success';
          statusBox.innerHTML = `
            <strong>&#10003; Report Generated!</strong><br/>
            File: <strong>${data.fileName}</strong><br/>
            <a class="download-btn" href="${BASE}/awscost/downloads/${data.fileName}">
              &#8595; Download Excel
            </a>`;
        } else {
          throw new Error(data.message || 'Generation failed');
        }
      } catch (e) {
        statusBox.className = 'status-box error';
        statusBox.innerHTML = '<strong>&#10007; Error:</strong> ' + e.message;
      } finally {
        await loadProfiles(); 
      }
    }

    loadProfiles();
  </script>
</body>

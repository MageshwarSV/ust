$baseDir = "C:\Users\143500\Desktop\awscost\awscost_feature\awscost\src\main\java\com\healthproof\intplus\awscost"

# 1. Update CostExplorerDev.java (Formula: Total - CloudWatch - RDS + Common)
$costExplorerPath = "$baseDir\awsDev\CostExplorerDev.java"
$ceContent = Get-Content $costExplorerPath -Raw
$oldCalc = 'private void calculateCommonService\(\) \{[\s\S]*?model\.getModelMapR14\(\)\.put\(ExcelMapper\.W12, String\.valueOf\(ec2\)\);[\s\S]*?\}'
$newCalc = @"
private void calculateCommonService() {
        Object commonObj = model.getModelMapR12().get(ExcelMapper.COMMON);
        Object totalObj = model.getModelMapR12().get(ExcelMapper.NO_KEY_PRODUCT);
        Object y12Obj = model.getModelMapR14().get(ExcelMapper.Y12);
        Object rdsObj = model.getModelMapR14().get("Amazon Relational Database Service");

        double common = new BigDecimal(commonObj != null ? commonObj.toString() : "0").setScale(2, RoundingMode.HALF_UP).doubleValue();
        double total = new BigDecimal(totalObj != null ? totalObj.toString() : "0").setScale(2, RoundingMode.HALF_UP).doubleValue();
        double cloudwatch = new BigDecimal(y12Obj != null ? y12Obj.toString() : "0").setScale(2, RoundingMode.HALF_UP).doubleValue();
        double rds = new BigDecimal(rdsObj != null ? rdsObj.toString() : "0").setScale(2, RoundingMode.HALF_UP).doubleValue();

        double ec2 = total - cloudwatch - rds + common;
        model.getModelMapR14().put(ExcelMapper.W12, String.valueOf(ec2));
    }
"@
$ceContent = [regex]::Replace($ceContent, $oldCalc, $newCalc)
Set-Content -Path $costExplorerPath -Value $ceContent -Encoding utf8

# 2. Update Excel Processors to write Z12 and Z13 for EM Suite across all company processors
$processors = Get-ChildItem "$baseDir\excel\*ExcelProcessor.java"
foreach ($p in $processors) {
    $code = Get-Content $p.FullName -Raw
    if ($code -match 'writeR12' -and $code -notmatch 'Z12') {
        $code = $code -replace '(setNum\("V12".*?;\)', '$1 setNum("Z12",bd(val(m,"Product$EM")));'
    }
    if ($code -match 'writeR13' -and $code -notmatch 'Z13') {
        $code = $code -replace '(setNum\("Y13".*?;\)', '$1 setNum("Z13",bd(val(m,"Product$EM")));'
    }
    Set-Content -Path $p.FullName -Value $code -Encoding utf8
}

Write-Host "All SOP updates successfully applied to project!" -ForegroundColor Green

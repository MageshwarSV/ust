"--- FILE STRUCTURE ---" | Out-File java_html_export.txt -Encoding utf8
Get-ChildItem -Recurse -Include *.java, *.html | Select-Object -ExpandProperty FullName | Out-File java_html_export.txt -Append -Encoding utf8

"`n--- FILE CONTENTS ---" | Out-File java_html_export.txt -Append -Encoding utf8
Get-ChildItem -Recurse -Include *.java, *.html | ForEach-Object {
    "`n=== FILE: $($_.FullName) ==="
    Get-Content $_.FullName -Raw
} | Out-File java_html_export.txt -Append -Encoding utf8

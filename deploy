package com.healthproof.intplus.awscost.util;

import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.Locale;

public class DateUtil {
    public static String getRequiredDate(){
        LocalDate now = LocalDate.now().minusMonths(1);
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("MMMM yyyy", Locale.ENGLISH);
        String result = now.format(formatter);
        System.out.println(result);
        return result;
    }
    public static String getCurrentDate(){
        LocalDate today = LocalDate.now();
        DateTimeFormatter dtf = DateTimeFormatter.ofPattern("yyyy-MM-dd");
        String currentFirst = today.withDayOfMonth(1).format(dtf);
        return currentFirst;
    }
    public static String getPreviousDate(){
        LocalDate today = LocalDate.now();
        DateTimeFormatter dtf = DateTimeFormatter.ofPattern("yyyy-MM-dd");
        String previousFirst = today.minusMonths(1).withDayOfMonth(1).format(dtf);
        return previousFirst;
    }
    public static String getCurrentTimeStamp(){
        DateTimeFormatter dateTimeFormatter = DateTimeFormatter.ofPattern("yyyyMMdd_HHmmss");
        String timeStamp = LocalDateTime.now().format(dateTimeFormatter);
        return timeStamp;
    }
}



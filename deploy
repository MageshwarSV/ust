$baseDir = "C:\Users\143500\Desktop\awscost\awscost_feature\awscost\src\main\java\com\healthproof\intplus\awscost"
$utf8NoBom = New-Object System.Text.UTF8Encoding $false

# 1. Update W12 formula in CostExplorerDev.java
$cePath = "$baseDir\awsDev\CostExplorerDev.java"
if (Test-Path $cePath) {
    $ceContent = [System.IO.File]::ReadAllText($cePath)
    $oldLine = 'double ec2 = total - new BigDecimal(y12Obj != null ? y12Obj.toString() : "0").setScale(2, RoundingMode.HALF_UP).doubleValue() + common;'
    $newLine = @"
Object rdsObj = model.getModelMapR14().get("Amazon Relational Database Service");
        double rds = new BigDecimal(rdsObj != null ? rdsObj.toString() : "0").setScale(2, RoundingMode.HALF_UP).doubleValue();
        double cloudwatch = new BigDecimal(y12Obj != null ? y12Obj.toString() : "0").setScale(2, RoundingMode.HALF_UP).doubleValue();
        double ec2 = total - cloudwatch - rds + common;
"@
    if ($ceContent.Contains($oldLine)) {
        $ceContent = $ceContent.Replace($oldLine, $newLine)
        [System.IO.File]::WriteAllText($cePath, $ceContent, $utf8NoBom)
        Write-Host "CostExplorerDev.java updated with SOP W12 formula!" -ForegroundColor Green
    }
}

# 2. Update Z12 & Z13 in Excel processors
Get-ChildItem "$baseDir\excel\*ExcelProcessor.java" | ForEach-Object {
    $code = [System.IO.File]::ReadAllText($_.FullName)
    $v12Old = 'setNum("V12",bd(val(m,ExcelMapper.V12)));'
    $v12New = 'setNum("V12",bd(val(m,ExcelMapper.V12))); setNum("Z12",bd(val(m,"Product$EM")));'
    $y13Old = 'setNum("Y13",bd(val(m,ExcelMapper.Y13)));'
    $y13New = 'setNum("Y13",bd(val(m,ExcelMapper.Y13))); setNum("Z13",bd(val(m,"Product$EM")));'
    
    if (-not $code.Contains("Z12") -and $code.Contains($v12Old)) {
        $code = $code.Replace($v12Old, $v12New)
    }
    if (-not $code.Contains("Z13") -and $code.Contains($y13Old)) {
        $code = $code.Replace($y13Old, $y13New)
    }
    [System.IO.File]::WriteAllText($_.FullName, $code, $utf8NoBom)
}

Write-Host "All SOP updates applied! Now rebuild in IntelliJ!" -ForegroundColor Green

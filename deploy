$baseDir = "C:\Users\143500\Desktop\awscost\awscost_feature\awscost\src\main\java"
$utf8NoBom = New-Object System.Text.UTF8Encoding $false

Get-ChildItem -Path $baseDir -Recurse -Filter "*.java" | ForEach-Object {
    $text = [System.IO.File]::ReadAllText($_.FullName)
    
    # Fix truncated 'ackage' -> 'package'
    if ($text.StartsWith("ackage ")) {
        $text = "p" + $text
    }
    
    # Strip BOM if present and fix 'ackage'
    if ($text.StartsWith([char]0xFEFF)) {
        $text = $text.Substring(1)
        if ($text.StartsWith("ackage ")) {
            $text = "p" + $text
        }
    }
    
    [System.IO.File]::WriteAllText($_.FullName, $text, $utf8NoBom)
}

Write-Host "All 'ackage' lines fixed to 'package'!" -ForegroundColor Green

# Run javac compilation test
$javac = (Get-Command javac -ErrorAction SilentlyContinue).Source
if (-not $javac) {
    $javac = (Get-ChildItem "C:\Program Files\Java", "C:\Program Files (x86)\Java", "$env:USERPROFILE\.jdks" -Recurse -Filter "javac.exe" -ErrorAction SilentlyContinue | Select-Object -First 1).FullName
}

if ($javac) {
    Write-Host "Running compilation check..." -ForegroundColor Yellow
    $targetDir = "C:\Users\143500\Desktop\awscost\awscost_feature\awscost\target\classes"
    if (-not (Test-Path $targetDir)) { New-Item -ItemType Directory -Path $targetDir -Force | Out-Null }
    $javaFiles = Get-ChildItem "C:\Users\143500\Desktop\awscost\awscost_feature\awscost\src\main\java" -Recurse -Filter "*.java" | Select-Object -ExpandProperty FullName
    & $javac -d $targetDir $javaFiles 2>&1
}
